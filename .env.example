# Copy to .env and fill in your values, OR set as GitHub Actions Secrets.

# The Cineplex movie page (Odyssey 70mm) — used in notification links.
MOVIE_URL=https://www.cineplex.com/movie/the-odyssey-the-imax-experience-in-70mm-film

# Cineplex film ID (from __NEXT_DATA__ on the movie page).
FILM_ID=38376

# A substring used to match the theatre name in API results.
LOCATION_KEYWORD=Langley

# Discord webhook URL — create one in any Discord server you control:
#   Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
# Then install Discord on your phone and enable push notifications.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYYYYYYYYYYY

# Where to keep state between runs.
STATE_FILE=state.json
